# 飞书应用配置
APP_ID=cli_your_app_id_here
APP_SECRET=your_app_secret_here

# 飞书多维表格配置
BITABLE_APP_TOKEN=bascn_your_bitable_token_here
BITABLE_PROJECT_TABLE_ID=tbl_project_table_id
BITABLE_LOG_TABLE_ID=tbl_log_table_id
BITABLE_KEYWORD_TABLE_ID=tbl_keyword_table_id
BITABLE_QUOTE_TABLE_ID=tbl_quote_table_id

# 飞书事件订阅配置（用于群聊消息监听）
FEISHU_VERIFICATION_TOKEN=your_verification_token_here
FEISHU_ENCRYPT_KEY=your_encrypt_key_here
# 是否使用长连接模式（推荐true，无需公网地址；false则使用HTTP回调模式）
FEISHU_USE_LONG_CONNECTION=true

# 机器人名称（用于识别@提及，私聊确认消息也使用此名称）
BOT_NAME=爆米花机-对话型

# ============================================================
# 群聊与机器人 Webhook 配置（集中管理）
# ============================================================

# --- DDL播报群（4个群对应4个人员字段，每个群只播报对应字段有人的项目）---

# owner群（对应 owner 字段）
OWNER_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_hook_id
OWNER_CHAT_ID=oc_your_owner_chat_id

# dkyj组（对应 dkyjcontributers 字段）
DKYJ_WEBHOOK_URL=
DKYJ_CHAT_ID=

# sj组（对应 sjcontributers 字段）
SJ_WEBHOOK_URL=
SJ_CHAT_ID=

# xy组（对应 xycontributers 字段）
XY_WEBHOOK_URL=
XY_CHAT_ID=

# --- 其他群聊配置 ---

# 关键词监听群聊 ID（仅在此群监听关键词消息）
KEYWORD_CHAT_ID=

# 会议提醒监控群聊 ID（多个群聊用逗号分隔，留空则所有群都监控）
MEETING_CHAT_IDS=

# 服务器配置
PORT=3000
NODE_ENV=development

# 定时任务配置（cron表达式，默认每天12点）
CRON_SCHEDULE=0 0 12 * * *

# DDL预警天数
DDL_ALERT_DAYS=2

# 3D打印服务配置（用于指令转发）
# 当收到 /print-* 指令时，会转发到此地址处理
PRINT_SERVER_URL=http://localhost:3001

# ticket-bot 服务地址（每日DDL播报完成后联动触发其「待处理/无人接单工单」汇总播报）
TICKET_BOT_URL=http://localhost:3003
