# 飞书应用配置
APP_ID=cli_your_app_id_here
APP_SECRET=your_app_secret_here

# 飞书多维表格配置
BITABLE_APP_TOKEN=bascn_your_bitable_token_here
BITABLE_PROJECT_TABLE_ID=tbl_project_table_id
BITABLE_LOG_TABLE_ID=tbl_log_table_id
BITABLE_KEYWORD_TABLE_ID=tbl_keyword_table_id
BITABLE_QUOTE_TABLE_ID=tbl_quote_table_id

# 飞书事件订阅配置（用于群聊消息监听）
FEISHU_VERIFICATION_TOKEN=your_verification_token_here
FEISHU_ENCRYPT_KEY=your_encrypt_key_here
# 必须为 false：共用应用的唯一长连接属于 feishu-gateway，本服务开长连接会被飞书随机分发抢事件
FEISHU_USE_LONG_CONNECTION=false

# 机器人名称（用于识别@提及，私聊确认消息也使用此名称）
BOT_NAME=爆米花机-对话型

# ============================================================
# 群聊与机器人 Webhook 配置（集中管理）
# ============================================================

# --- DDL播报群（4个群对应4个人员字段，每个群只播报对应字段有人的项目）---

# owner群（对应 owner 字段）
OWNER_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_hook_id
OWNER_CHAT_ID=oc_your_owner_chat_id

# dkyj组（对应 dkyjcontributers 字段）
DKYJ_WEBHOOK_URL=
DKYJ_CHAT_ID=

# sj组（对应 sjcontributers 字段）
SJ_WEBHOOK_URL=
SJ_CHAT_ID=

# xy组（对应 xycontributers 字段）
XY_WEBHOOK_URL=
XY_CHAT_ID=

# --- 其他群聊配置 ---

# 关键词监听群聊 ID（仅在此群监听关键词消息）
KEYWORD_CHAT_ID=

# 关键词回答表的监听群范围（命中 autoReplies.json 回答表时自动回答，仅作用于未@机器人的群消息）
# 逗号分隔 chat_id；'*' 或留空 = 所有群（与关键词监听插件 KEYWORD_CHAT_ID 互不影响）
# @触发回答表（autoRepliesMention.json）不读本项：它靠「群里@机器人」门禁，全群可用
# AUTO_REPLY_CHAT_IDS=

# 会议提醒监控群聊 ID（多个群聊用逗号分隔）
# 注意：当前实现监听机器人所在所有群，此配置已不生效（仅保留兼容）
MEETING_CHAT_IDS=

# 服务器配置
PORT=3000
NODE_ENV=development

# 定时任务配置（cron表达式，默认每天12点）
CRON_SCHEDULE=0 0 12 * * *

# DDL预警天数
DDL_ALERT_DAYS=2

# 3D打印服务配置（用于指令转发）
# 当收到 /print-* 指令时，会转发到此地址处理
PRINT_SERVER_URL=http://localhost:3001

# ticket-bot 服务地址（DDL 卡「未结单工单」按负责人组分栏的取数来源 GET /api/tickets/unclosed-by-group；
# 取数失败自动降级为全群共用同一份，再失败不含工单分栏）
TICKET_BOT_URL=http://localhost:3003

# ticket-bot 工单源表读取配置（同一多维表格 base，以下默认值与 ticket-bot 配置一致，一般无需修改）
# TICKET_SOURCE_TABLE_ID=tblFA6Pj4Mv83Mb0
# TICKET_APPROVAL_FIELD=审批节点
# TICKET_CLOSE_VALUE=回执单：是否结单
# TICKET_DEADLINE_FIELD=理想结单时间
# TICKET_ASSIGNEE_FIELD=指定负责人
# TICKET_SUPPLEMENT_FIELD=补充负责人
# TICKET_ACCEPT_VALUES=群内有组员接单后通过,有组员接单后通过,负责人确认消息后通过
# TICKET_ROUTE_FIELD=面向组别

# 审批群（approval-bot 财务能力）：本群指令整体切换为财务相关
APPROVAL_CHAT_ID=oc_1ea53731a8772400450da6ab107f8331
APPROVAL_SERVICE_URL=http://localhost:3002

# ---------------- NAS 部署配置（push.js 用，严禁提交） ----------------
NAS_HOST=10.253.33.233
NAS_PORT=8500
NAS_USER=qianli
NAS_PASSWORD=

# ---------------- 私聊指令白名单（指令仅群内触发） ----------------
# 指令只在群聊里 @机器人 触发并回复到对应群；私聊指令仅白名单可用（open_id / p2p chat_id
# 任一命中即可，逗号分隔）。两个都留空 = 私聊指令对所有人关闭（含管理员，fail-closed）。
# P2P_COMMAND_OPEN_IDS=ou_xxx
# P2P_COMMAND_CHAT_IDS=oc_xxx

# ---------------- 晚间静默（播报时段限制） ----------------
# 播报静默窗口 [START, END)（Asia/Shanghai 整点）：窗口内定时/自动播报不直接发送，
# 积压到 END 整点统一补发（任务类重跑取补发时刻数据；一次性通知原样补发）。
# 对话/指令回复与人工当下主动触发不受限。默认 2→9，留空即默认。
# QUIET_HOURS_START=2
# QUIET_HOURS_END=9
# QUIET_HOURS_DISABLED=1
